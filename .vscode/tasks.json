{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: Commit + Push All Folders",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/git-commit-all.ps1"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Docker: Start Dev Services",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "compose.local.yaml",
        "up",
        "-d",
        "db"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "projectbt-database",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Docker: Stop Dev Services",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "compose.local.yaml",
        "stop",
        "db"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "projectbt-database",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Docker: Local MySQL Status",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "compose.local.yaml",
        "ps",
        "db"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "projectbt-database",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Run Customer Dashboard",
      "detail": "Runs the ProjectBT frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/frontendclientbt"
      },
      "presentation": {
        "group": "projectbt-frontend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Run API",
      "detail": "Runs the ProjectBT backend API",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-backend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Run Admin Dashboard",
      "detail": "Opens Prisma Studio as the local database administration interface",
      "type": "shell",
      "command": "npx",
      "args": [
        "prisma",
        "studio",
        "--config=./prisma.config.ts"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-prisma",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Dev: Run Backend + Frontend",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Run API",
        "Run Customer Dashboard"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Prisma: Migrate API",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "prisma:deploy"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-prisma",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Prisma: Generate API Client",
      "type": "shell",
      "command": "npx",
      "args": [
        "prisma",
        "generate",
        "--schema",
        "prisma/schema"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-prisma",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Prisma: Migration Status",
      "type": "shell",
      "command": "npx",
      "args": [
        "prisma",
        "migrate",
        "status",
        "--config=./prisma.config.ts"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-prisma",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Prisma: Studio API",
      "type": "shell",
      "command": "npx",
      "args": [
        "prisma",
        "studio",
        "--config=./prisma.config.ts"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-prisma",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Database: Ensure Module Catalog",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/ensure-catalog.js"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-database",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Database: Prepare Local Database",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Docker: Start Dev Services",
        "Prisma: Migrate API",
        "Database: Ensure Module Catalog"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Dev: Run Customer + Admin + API + Desktop",
      "detail": "Starts MySQL, applies migrations, ensures the catalog, and runs the ProjectBT backend and frontend",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Database: Prepare Local Database",
        "Dev: Run Backend + Frontend"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/backendbt"
      },
      "presentation": {
        "group": "projectbt-build",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/frontendclientbt"
      },
      "presentation": {
        "group": "projectbt-build",
        "panel": "dedicated",
        "reveal": "always",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Build: Backend + Frontend",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Backend",
        "Build Frontend"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false
      }
    }
  ]
}